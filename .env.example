# Backend configuration. The default local mode needs no API key.
# Local development only. On Render, omit HOST or set it to 0.0.0.0.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/jarvis.sqlite

# local (commands only), groq (remote model), or ollama (your model server).
AI_PROVIDER=local
# Set a model identifier available in your chosen provider before enabling AI.
AI_MODEL=
# Backend only. Never use a VITE_ variable for a key; never commit .env.
GROQ_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# Global daily attempts, persisted in SQLite. Failed attempts also count.
AI_DAILY_LIMIT=100
# Exact frontend origin, without path or trailing slash. Comma-separated if needed.
ALLOWED_ORIGINS=https://eriksmoura14-ai.github.io

# Optional single-owner account. Backend only, never use VITE_ variables.
# Set a strong personal password with 12–200 characters to enable login.
JARVIS_PASSWORD=
# For durable storage on Render, configure both after running supabase/personal.sql.
# Use a backend secret key or legacy service_role key, never publishable/anon.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional natural voice. Requires personal mode and an ElevenLabs Free account.
# browser needs no key. Set all three on Render to enable natural voice.
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
